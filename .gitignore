# Ignore actual mod files
/mods/
/coremods/

# Ignore personal player data and saves
/saves/
/usercache.json
/usernamecache.json
/command_history.txt
/essential/

# Ignore logs and crashes
/logs/
/crash-reports/

# Ignore personal settings and temp files

/downloads/
/local/
create_radar_debug/
ponders_watched.json

# Optional: Ignore asset packs if you didn't make them
# /resourcepacks/
# /shaderpacks/
# Ignore all dotfiles and dotfolders by default
.*

# Exceptions: keep essential Git files
!.gitignore
!.gitattributes
!.git/

# Explicitly ignore common build/cache directories & patterns
.mixin_out/
.mixin.out/
.cache/
.sable/
*.class
